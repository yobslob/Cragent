# LLM API Keys (choose one or more)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# OpenRouter (optional — use openrouter/* model prefix)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_REFERRER=https://your-app.com
# OPENROUTER_APP_TITLE=Autonomous Testing Agent

# Groq (optional — use groq/* model prefix)
# GROQ_API_KEY=gsk_...

# LangSmith Observability (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=autonomous-testing-agent

# Config overrides (all optional, prefix with ATA_)
# ATA_MAX_DEPTH=10
# ATA_MAX_CONCURRENCY=5
# ATA_PRIMARY_MODEL=gpt-4o
# ATA_HEADLESS=true
# ATA_BATCH_SIZE=7
